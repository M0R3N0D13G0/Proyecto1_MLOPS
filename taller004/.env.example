# Copiar a .env antes de levantar:  cp .env.example .env
# Valores de desarrollo; cambiarlos si se despliega en la MV.

# --- Postgres de METADATA de MLflow (experimentos, runs, registro de modelos) ---
MLFLOW_DB_USER=mlflow
MLFLOW_DB_PASSWORD=mlflow
MLFLOW_DB_NAME=mlflow

# --- Postgres de DATOS (crudos + procesados). Distinto al de MLflow ---
DATA_DB_USER=data
DATA_DB_PASSWORD=data
DATA_DB_NAME=penguins

# --- MinIO dedicado a MLflow (artefactos: modelos, plots, etc.) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MLFLOW_BUCKET=mlflow

# --- Puertos en el HOST (cambiarlos si chocan con otro stack, p.ej. proyecto1 usa 8000/9000/9001) ---
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
JUPYTER_HOST_PORT=8888
API_HOST_PORT=8000

# --- MLflow ---
# Host headers aceptados por el servidor (MLflow 3.x rechaza los demas con 403).
# "mlflow" es el nombre del servicio dentro de la red de Docker (Jupyter y la API lo usan).
MLFLOW_ALLOWED_HOSTS=mlflow,mlflow:5000,localhost,localhost:*,127.0.0.1,127.0.0.1:*,10.*,192.168.*
# En macOS el 5000 suele estar ocupado por AirPlay Receiver: usar 5001.
MLFLOW_HOST_PORT=5000

# --- JupyterLab ---
JUPYTER_TOKEN=devtoken

# --- API: que modelo del Model Registry sirve ---
MODEL_NAME=penguins-classifier
MODEL_ALIAS=champion
